# Copy to test.env (gitignored). Loaded from the working directory when present;
# does not override variables already set in the environment.

LOG_LEVEL=info

# header (default) or route
PROXY_MODE=header
# Required when PROXY_MODE=route; must be unset in header mode.
# ROUTES=[{"host":"example.com","path_prefix":"/location1","upstream":"https://origin.example.com:443","rewrite_prefix":"/"}]
ROUTE_MAX_HOPS=1

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s

UPSTREAM_TIMEOUT=30s
UPSTREAM_MAX_BYTES=33554432

# Must be > 0: UPSTREAM_TIMEOUT, UPSTREAM_MAX_BYTES, SHUTDOWN_TIMEOUT.
# Booleans accept true/false (1/0); anything else fails startup.
UPSTREAM_DEFAULT_SCHEME=https
# Header mode: allow http upstreams (default scheme or X-L7-Target-Scheme: http).
UPSTREAM_ALLOW_HTTP=false
# Header mode SSRF guard: refuse loopback, private, link-local (metadata), CGNAT, multicast
# and other non-public resolved IPs. true disables it (local tests only).
UPSTREAM_ALLOW_PRIVATE=false
# Header mode: reachable target ports (implicit port: 443 for https, 80 for http).
UPSTREAM_ALLOW_PORTS=80,443,8443,9443
# Bare hostnames only, no ports.
UPSTREAM_ALLOW_HOSTS=
UPSTREAM_ALLOW_SUFFIXES=
UPSTREAM_DENY_HOSTS=

# CONNECT tunnel (header mode only): own listener, empty = disabled. Must be exposed at L4
# (TLS passthrough or a LoadBalancer Service), not through an L7 ingress. Without auth it
# needs UPSTREAM_ALLOW_HOSTS or UPSTREAM_ALLOW_SUFFIXES, else startup fails.
TUNNEL_ADDR=
# Reachable target ports; add exchange WebSocket ports (e.g. 8443,9443) when needed.
TUNNEL_ALLOW_PORTS=443
# Closes a tunnel after this long without traffic in either direction.
TUNNEL_IDLE_TIMEOUT=10m
# Client -> proxy TLS (both or neither); reloaded when the files change. Unset = plain HTTP.
TUNNEL_TLS_CERT_FILE=
TUNNEL_TLS_KEY_FILE=

# Auth off for local/tests. Enable in production pods.
AUTH_ENABLED=false
AUTH_MODE=instance
# Instance mode: one token or a comma-separated list (whitespace trimmed, empty items dropped,
# no commas inside a token), e.g. PROXY_AUTH_TOKEN=tok-a,tok-b. Any one matches.
# Generate each with: openssl rand -hex 32
# Capacity: Linux caps one env string at 128 KiB (MAX_ARG_STRLEN), a k8s Secret at 1 MiB;
# 64-char tokens + comma fit about 2000 tokens. Per-request cost: one SHA-256 + N compares.
PROXY_AUTH_TOKEN=
PROXY_AUTH_HOST_MAP=
