# Copy to test.env (gitignored). Loaded from the working directory when present;
# does not override variables already set in the environment.

LOG_LEVEL=info

# header (default) or route
PROXY_MODE=header
# Required when PROXY_MODE=route; must be unset in header mode.
# ROUTES=[{"host":"example.com","path_prefix":"/location1","upstream":"https://origin.example.com:443","rewrite_prefix":"/"}]
ROUTE_MAX_HOPS=1

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s

UPSTREAM_TIMEOUT=30s
UPSTREAM_MAX_BYTES=33554432

UPSTREAM_DEFAULT_SCHEME=https
UPSTREAM_ALLOW_HOSTS=
UPSTREAM_ALLOW_SUFFIXES=
UPSTREAM_DENY_HOSTS=

# Auth off for local/tests. Enable in production pods.
AUTH_ENABLED=false
AUTH_MODE=instance
PROXY_AUTH_TOKEN=
PROXY_AUTH_HOST_MAP=
