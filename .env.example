# Copy to test.env (gitignored). Loaded from the working directory when present;
# does not override variables already set in the environment.
# Booleans accept true/false (1/0); anything else fails startup.

# =============================================================================
# 1. REQUIRED
# =============================================================================
# Nothing is required to start: with no environment at all the service runs in
# header mode on :8080 with auth off. Below, per feature, what turns it on.

# --- Auth (header mode) ------------------------------------------------------
# Off by default; on exactly when one of these is set (both set = startup error).
# PROXY_AUTH_TOKEN: one token or a comma-separated list (whitespace trimmed, empty items
# dropped, no commas inside a token), e.g. PROXY_AUTH_TOKEN=tok-a,tok-b. Any one matches.
# Generate each with: openssl rand -hex 32
# Capacity: Linux caps one env string at 128 KiB (MAX_ARG_STRLEN), a k8s Secret at 1 MiB;
# 64-char tokens + comma fit about 2000 tokens. Per-request cost: one SHA-256 + N compares.
# PROXY_AUTH_TOKEN=
# Per-host tokens instead (JSON object host -> token):
# PROXY_AUTH_HOST_MAP={"api.example.com":"token"}

# --- CONNECT tunnel (header mode only) ---------------------------------------
# Two variables: the listen address plus a token (see Auth above). Own listener; expose it
# at L4 (TLS passthrough or a LoadBalancer Service), not through an L7 ingress.
# Without a token it needs UPSTREAM_ALLOW_HOSTS or UPSTREAM_ALLOW_SUFFIXES, else startup fails.
# TUNNEL_ADDR=:8443
# TLS certificate files are recommended, not required (both or neither); reloaded on change.
# TUNNEL_TLS_CERT_FILE=
# TUNNEL_TLS_KEY_FILE=

# --- Path mode ---------------------------------------------------------------
# Target in the URL for clients that cannot set headers: /h/<host>[:port]/<path>.
# Same token, policy and guards as header mode.
# PROXY_MODE=path

# --- Route mode --------------------------------------------------------------
# Static host + path-prefix table instead of header mode; no auth, no tunnel.
# PROXY_MODE=route
# ROUTES=[{"host":"example.com","path_prefix":"/location1","upstream":"https://origin.example.com:443","rewrite_prefix":"/"}]

# =============================================================================
# 2. OPTIONAL (every line shows its default)
# =============================================================================

# --- Listener ----------------------------------------------------------------
# HTTP_ADDR=:8080
# TLS on the main listener (both or neither; HTTP/2 via ALPN; reloaded on change).
# For deployments without an ingress.
# HTTP_TLS_CERT_FILE=
# HTTP_TLS_KEY_FILE=
# Cleartext HTTP/2 with prior knowledge, only when TLS is off.
# HTTP_H2C=false
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=0
# HTTP_WRITE_TIMEOUT=0
# HTTP_IDLE_TIMEOUT=120s
# SHUTDOWN_TIMEOUT=15s
# READ/WRITE_TIMEOUT 0 = off (default, keeps SSE, downloads and WebSocket alive). A
# non-zero value caps the whole request or response, so it cuts long streams.

# --- Upstream limits ---------------------------------------------------------
# Must be > 0: UPSTREAM_TIMEOUT, UPSTREAM_MAX_BYTES, SHUTDOWN_TIMEOUT.
# UPSTREAM_TIMEOUT=30s
# UPSTREAM_MAX_BYTES=33554432
# UPSTREAM_DEFAULT_SCHEME=https
# Header mode: allow http upstreams (default scheme or X-L7-Target-Scheme: http).
# UPSTREAM_ALLOW_HTTP=false
# Header mode SSRF guard: refuse loopback, private, link-local (metadata), CGNAT, multicast
# and other non-public resolved IPs. true disables it (local tests only).
# UPSTREAM_ALLOW_PRIVATE=false
# Header mode: send X-Forwarded-For/Host/Proto to the upstream. Inbound values are trusted
# unless UPSTREAM_TRUSTED_PROXIES (comma-separated IPs/CIDRs, IPv4 and IPv6) is set.
# UPSTREAM_FORWARD_CLIENT_IP=false
# UPSTREAM_TRUSTED_PROXIES=10.0.0.0/8,2001:db8::/32
# Header mode: reachable target ports (implicit port: 443 for https, 80 for http).
# UPSTREAM_ALLOW_PORTS=80,443,8443,9443
# Route mode: max X-L7-Hops before 508 loop_detected.
# ROUTE_MAX_HOPS=1

# --- Policy (header mode; bare hostnames only, no ports) ----------------------
# UPSTREAM_ALLOW_HOSTS=
# UPSTREAM_ALLOW_SUFFIXES=
# UPSTREAM_DENY_HOSTS=

# --- Tunnel tuning -----------------------------------------------------------
# Reachable target ports; add exchange WebSocket ports (e.g. 8443,9443) when needed.
# TUNNEL_ALLOW_PORTS=443
# Closes a tunnel after this long without traffic in either direction.
# TUNNEL_IDLE_TIMEOUT=10m
# Cap on concurrent tunnels (each holds two sockets); 0 = unlimited. Over the cap: 503 tunnel_capacity.
# TUNNEL_MAX_CONNECTIONS=300

# --- Metrics (#1) ------------------------------------------------------------
# Prometheus /metrics on its OWN listener, never on HTTP_ADDR or TUNNEL_ADDR. Full bind
# address like HTTP_ADDR, port required. Empty (default) = no metrics listener.
# Never publish this port through public ingress; scrape from the private network only.
# Kubernetes / cluster scrape (all interfaces):
# METRICS_ADDR=:9090
# Bare metal / docker host network (this host only):
# METRICS_ADDR=127.0.0.1:9090
# Constant `location` label on every lux_l7_ series (empty = no label; a Prometheus target
# label works too). 1-32 chars: letters, digits, '.', '_', '-'.
# METRICS_LOCATION=eu-1
# Header mode: front hosts allowed as ingress_host label values; any other Host is "other".
# METRICS_INGRESS_HOSTS=front.example.com,front2.example.com

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL=info
